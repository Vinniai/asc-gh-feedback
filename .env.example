# Server
PORT=8484

# App Store Connect webhook (the secret you set when creating the webhook)
ASC_WEBHOOK_SECRET=

# App Store Connect API key (App Store Connect > Users and Access > Integrations > App Store Connect API)
# Needs at least App Manager access to the app for beta feedback endpoints
ASC_KEY_ID=
ASC_ISSUER_ID=
# Either paste the .p8 contents (\n-escaped) or base64 of the whole file: base64 < AuthKey.p8
ASC_PRIVATE_KEY=
ASC_PRIVATE_KEY_B64=

# GitHub (fine-grained PAT with Issues:write + Contents:write on the target repo)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_ASSET_DIR=.testflight/feedback
GITHUB_LABELS=testflight-feedback,needs-triage

# Claude routine (claude.ai/code/routines > your routine > API trigger). Optional:
# leave blank to skip routine firing and just get labeled GitHub issues.
CLAUDE_ROUTINE_ID=
CLAUDE_ROUTINE_TOKEN=
